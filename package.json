{
  "name": "queens-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run --exclude scripts/scrape-archive.test.ts",
    "test:scraper": "vitest run scripts/scrape-archive.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "import:linkedin": "tsx scripts/import-linkedin-archive.ts",
    "import:text": "tsx scripts/import-text-puzzles.ts",
    "scrape:archive": "tsx scripts/scrape-archive.ts",
    "generate": "node --import tsx scripts/generate-puzzles.ts",
    "analyze": "node --import tsx scripts/analyze-patterns.ts",
    "benchmark": "node --import tsx scripts/benchmark-generators.ts",
    "import:recent": "node --import tsx scripts/import-recent-queens.ts",
    "analyze:history": "node --import tsx scripts/analyze-history.ts"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.0"
  }
}
